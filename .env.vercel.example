# ═══════════════════════════════════════════════════════════════
# Environment variables for the Vercel deployment (api/[...path].js).
# Set these in the Vercel dashboard → Project → Settings → Environment
# Variables. Never commit real values — this file is a template only.
# ═══════════════════════════════════════════════════════════════

# ── Turso (libSQL) — replaces Cloudflare D1 ──────────────────────
# Create with:
#   turso db create primarc-tendering
#   turso db show primarc-tendering --url            -> TURSO_DATABASE_URL
#   turso db tokens create primarc-tendering          -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://primarc-tendering-<org>.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-auth-token

# ── R2 (kept as the file store, reached via its S3-compatible API) ──
# Create an API token: Cloudflare dashboard → R2 → Manage R2 API Tokens
# (needs Object Read & Write on the primarc-tendering-documents bucket).
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=primarc-tendering-documents

# ── Session / auth (same semantics as CLOUDFLARE-README.md) ─────
# openssl rand -hex 32
SESSION_PEPPER=replace-with-a-long-random-string
# One-time token that enables POST /api/auth/bootstrap. Set it, create the
# first admin, then delete this var — the endpoint also refuses once any
# admin exists.
BOOTSTRAP_TOKEN=replace-with-a-one-time-token

# ── Everything below has a safe default (see api/[...path].js) ──
ENVIRONMENT=production
# Frontend and API now share one Vercel origin, so this only matters if you
# also serve the frontend from somewhere else (a preview URL, a custom
# domain not yet added, etc). Comma-separate to allow more than one origin.
ALLOWED_ORIGINS=https://your-project.vercel.app
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=true
