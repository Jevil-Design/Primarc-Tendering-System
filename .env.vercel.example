# ═══════════════════════════════════════════════════════════════
# Environment variables for the Vercel deployment (api/handler.js).
# Set these in the Vercel dashboard → Project → Settings → Environment
# Variables. Never commit real values — this file is a template only.
#
# IMPORTANT: when adding these, uncheck/disable "Sensitive" (use the CLI's
# `--no-sensitive` flag, or the dashboard toggle). On at least this project,
# Sensitive-type variables never reached process.env in the deployed
# function at all (confirmed with a throwaway non-sensitive test var that
# worked fine right next to Sensitive ones that read as empty) — despite
# Vercel's own docs saying Sensitive vars should still be readable at
# runtime. Non-sensitive is still private to the team, just not
# additionally encrypted-at-rest — an acceptable trade for this project.
# ═══════════════════════════════════════════════════════════════

# ── Turso (libSQL) — replaces Cloudflare D1 ──────────────────────
# Create with:
#   turso db create primarc-tendering
#   turso db show primarc-tendering --url            -> TURSO_DATABASE_URL
#   turso db tokens create primarc-tendering          -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://primarc-tendering-<org>.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-auth-token

# ── File storage: Vercel Blob (private) — no vars needed here ────
# Create a private Blob store (Project → Storage → Create Database → Blob →
# Private) and connect it to this project. That's it — Vercel adds
# BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically, and the SDK (api/_lib/
# storage.js) authenticates via OIDC with no static secret to configure.

# ── Session / auth ────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_PEPPER=replace-with-a-long-random-string
# One-time token that enables POST /api/auth/bootstrap. Set it, create the
# first admin, then delete this var — the endpoint also refuses once any
# admin exists.
BOOTSTRAP_TOKEN=replace-with-a-one-time-token

# ── Everything below has a safe default (see api/handler.js) ────
ENVIRONMENT=production
# Frontend and API now share one Vercel origin, so this only matters if you
# also serve the frontend from somewhere else (a preview URL, a custom
# domain not yet added, etc). Comma-separate to allow more than one origin.
ALLOWED_ORIGINS=https://your-project.vercel.app
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=true
