# ─── Not for version control ──────────────────────────────────────
node_modules/
.DS_Store
.thumbnail
scraps/

# Worker secrets — set with `wrangler secret put`, never committed
.dev.vars
.env

# User-uploaded working files (Excel, PDF); not source
uploads/

# ─── Dead code, deliberately not pushed ───────────────────────────
# Superseded by the Cloudflare Workers backend. Kept locally only so the
# old adapters stay readable during the Phase 3 rewiring. Delete when done.
server/
cloud/

# Generated deploy mirror — superseded by web/, do not track
github-deploy/

# NOTE: web/ IS committed on purpose. It is generated by make-web.sh, but a
# git-connected Cloudflare build can only deploy what is in the repository.
# Regenerate and commit it whenever the app or its modules change.

.vercel
.env*
