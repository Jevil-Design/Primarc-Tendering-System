# ═══════════════════════════════════════════════════════════════
# Local development — used by `vercel dev` (api/handler.js).
# Copy to `.env` (already git-ignored) and fill in real values.
#
# These are the SAME variables Vercel needs in production — see
# `.env.vercel.example` for where to set those in the dashboard and how to
# obtain each value (Turso DB creation, etc). File storage (Vercel Blob)
# needs no vars here — run `vercel env pull` after connecting a Blob store
# so its OIDC token is available locally too.
# ═══════════════════════════════════════════════════════════════

# ── Turso (libSQL) ────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://primarc-tendering-<org>.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-auth-token

# ── Session / auth ─────────────────────────────────────────────
SESSION_PEPPER=replace-with-a-long-random-string
# Enables POST /api/auth/bootstrap (first admin). Leave unset once an
# administrator exists — the endpoint refuses anyway.
# BOOTSTRAP_TOKEN=

# ── Everything below has a safe default (see api/handler.js) ──
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false
