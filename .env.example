# ═══════════════════════════════════════════════════════════════
# Local development — used by `vercel dev` (api/[...path].js).
# Copy to `.env` (already git-ignored) and fill in real values.
#
# These are the SAME variables Vercel needs in production — see
# `.env.vercel.example` for where to set those in the dashboard and how to
# obtain each value (Turso DB creation, R2 API token, etc).
# ═══════════════════════════════════════════════════════════════

# ── Turso (libSQL) ────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://primarc-tendering-<org>.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-auth-token

# ── R2 (S3-compatible API) ────────────────────────────────────
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=primarc-tendering-documents

# ── Session / auth ─────────────────────────────────────────────
SESSION_PEPPER=replace-with-a-long-random-string
# Enables POST /api/auth/bootstrap (first admin). Leave unset once an
# administrator exists — the endpoint refuses anyway.
# BOOTSTRAP_TOKEN=

# ── Everything below has a safe default (see api/[...path].js) ──
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false
