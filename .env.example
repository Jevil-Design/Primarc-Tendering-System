# ═══════════════════════════════════════════════════════════════
# Frontend configuration — Cloudflare Workers backend.
#
# The Worker's own secrets (SESSION_PEPPER, BOOTSTRAP_TOKEN) do NOT belong
# here. They live in cloudflare/worker/.dev.vars for local development and in
# `wrangler secret put ... --env production` for production.
# See CLOUDFLARE-README.md and MIGRATION.md.
# ═══════════════════════════════════════════════════════════════

# Base URL of the deployed Worker API. The page reads this as
# window.CLOUDFLARE_API_URL before cloudflare-api.js loads. In practice this is
# set by web/api-url.js, which auto-selects localhost:8787 for local dev and the
# production API elsewhere — this var is the documented default.
CLOUDFLARE_API_URL=https://primarc-tendering-api.suvojt740.workers.dev/api

# ── Worker secrets (set in cloudflare/worker/.dev.vars locally, or via
#    `wrangler secret put <NAME> --env production` for the deployed Worker) ──
#
# Extra entropy mixed into session-token hashing. Any long random string:
#   openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# SESSION_PEPPER=replace-with-a-long-random-string
#
# One-time token that enables POST /api/auth/bootstrap (first admin). Leave
# unset/blank once the first administrator exists — the endpoint refuses anyway.
# BOOTSTRAP_TOKEN=
